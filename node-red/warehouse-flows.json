  {
    "id": "3bad7d8f6fdb78c5",
    "type": "function",
    "z": "19de933b175759b7",
    "name": "function decode bin status",
    "func": "let raw = String(msg.payload).trim();\nraw = raw.replace(/\\+/g, \"\");\n\nlet parts = raw.split(\",\");\n\nlet binIndex = Number(parts[0]);\nlet state = Number(parts[1]);\n\nif (binIndex < 1 || binIndex > 54) {\n    node.error(\"Bin index ngoài phạm vi 1-54: \" + binIndex, msg);\n    return null;\n}\n\nlet suffix = String(binIndex).padStart(2, \"0\");\nlet binName = \"A0101\" + suffix;\n\nlet binId;\nif (binIndex <= 3) {\n    binId = binIndex;\n} else {\n    binId = binIndex + 9;\n}\n\nmsg.payload = {\n    bin_index: binIndex,\n    id: binId,\n    bin_name: binName,\n    bin_size: \"Tiny\",\n    bin_property: \"Normal\",\n    creater: \"DemoData\",\n    empty_label: state === 1,\n    occupied: state === 0\n};\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 670,
    "y": 1280,
    "wires": [

    "id": "4d6fc823434d097d",
    "type": "function",
    "z": "19de933b175759b7",
    "name": "function create/update stockbin",
    "func": "let bin = msg.payload;\n\nif (!bin || !bin.bin_name) {\n    return null;\n}\n\nif (bin.empty_label !== false) {\n    return null;\n}\n\nmsg.method = \"POST\";\nmsg.url = \"http://127.0.0.1:8008/stock/bin/plc_update/\";\n\nmsg.headers = {\n    token: \"REPLACE_WITH_GREATERWMS_TOKEN\",\n    \"Content-Type\": \"application/json\"\n};\n\nmsg.payload = {\n    bin_name: bin.bin_name,\n    goods_code: \"A000036\",\n    goods_desc: \"Goods Desc-36\",\n    goods_qty: 1,\n    pick_qty: 0,\n    picked_qty: 0,\n    bin_size: bin.bin_size || \"Tiny\",\n    bin_property: bin.bin_property || \"Normal\",\n    t_code: bin.bin_name,\n    openid: \"init_data\"\n};\n\nreturn msg;",

  {
    "id": "2397be87757aabc6",
    "type": "function",
    "z": "19de933b175759b7",
    "name": "Build reset 54 bins",
    "func": "const token = \"REPLACE_WITH_GREATERWMS_TOKEN\";\n\nlet messages = [];\n\nfor (let binIndex = 1; binIndex <= 54; binIndex++) {\n    let suffix = String(binIndex).padStart(2, \"0\");\n    let binName = \"A0101\" + suffix;\n\n    let binId;\n    if (binIndex <= 3) {\n        binId = binIndex;\n    } else {\n        binId = binIndex + 9;\n    }\n\n    messages.push({\n        method: \"PUT\",\n        url: \"http://127.0.0.1:8008/binset/\" + binId + \"/\",\n        headers: {\n            token: token,\n            \"Content-Type\": \"application/json\"\n        },\n        payload: {\n            id: binId,\n            bin_name: binName,\n            bin_size: \"Tiny\",\n            bin_property: \"Normal\",\n            creater: \"DemoData\",\n            empty_label: true,\n            bar_code: binName\n        }\n    });\n}\n\nreturn [messages];",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1010,
